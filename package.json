{
  "name": "pos-system",
  "version": "1.0.0",
  "description": "POS desktop application",
  "author": "Stephen Muiga kiragu",
  "main": "main.js",
  "scripts": {
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "electron": "electron .",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\" \"wait-on http://localhost:3000 && npm run electron\"",
    "dist": "cd backend && npm run package && cd ../frontend && npm run build && cd .. && npx electron-builder"
  },
  "build": {
    "appId": "com.Bythebuzz.POS",
    "productName": "Bythebuzz POS",
    "icon": "public/cash-machine.png",
    "files": [
      "main.js",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend.exe",
        "to": "backend.exe"
      },
      {
        "from": "backend/prisma/dev.db",
        "to": "dev.db"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.17.0",
    "multer": "^1.4.5-lts.1",
    "react-hook-form": "^7.77.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "uuid": "^10.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "wait-on": "^9.0.10"
  }
}
