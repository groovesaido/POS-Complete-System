# ── POS Backend Configuration ──
# Copy this file to .env and adjust as needed.
# The backend will work fine without a .env file — secrets are auto-generated and persisted.

# JWT Secret (optional — if not set, a persistent secret is auto-generated on first run)
# Set a fixed secret to share across multiple backend instances or avoid file-based persistence.
# JWT_SECRET=your-256-bit-secret-here

# JWT expiration duration (default: 7d)
# JWT_EXPIRES_IN=7d

# Database URL (default: file:./prisma/dev.db)
# DATABASE_URL=file:./prisma/dev.db

# Server port (default: 5000)
# PORT=5000

# Node environment (set to "production" in packaged Electron builds)
# NODE_ENV=development

# User data directory (set automatically by Electron in production)
# USER_DATA_DIR=/path/to/user/data

# Set to "true" to serve the built frontend from the backend
# SERVE_FRONTEND=true

# Path to frontend dist folder (default: ../../frontend/dist)
# FRONTEND_DIST=/path/to/frontend/dist
